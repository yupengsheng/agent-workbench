HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
DATABASE_URL=postgres://agent_workbench:change-me@127.0.0.1:5432/agent_workbench
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=30000
COOKIE_SECURE=false
ALLOW_INSECURE_MODEL_URLS=false
# 32-byte hex or base64 key used to encrypt API keys entered in the admin console.
MODEL_SECRET_ENCRYPTION_KEY=
# Runner 只读工具的工作区根目录；每个 workspace 使用其 UUID 作为子目录。
AGENT_WORKBENCH_WORKSPACE_ROOT=/opt/agent-workbench-test/workspaces
# Runner-only TypeSafe Jev router configuration. The key must never be sent to the browser.
TYPESAFE_API_KEY=
TYPESAFE_ROUTER_TIMEOUT_MS=5000
TYPESAFE_ROUTER_MIN_CONFIDENCE=0.65
# Runner-only web tool. Keep disabled unless an explicit public-host allowlist is configured.
AGENT_WORKBENCH_ENABLE_WEB_FETCH=false
AGENT_WORKBENCH_WEB_FETCH_ALLOWLIST=
